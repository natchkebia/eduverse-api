// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum CourseType {
  COURSE
  WORKSHOP
  MASTERCLASS
}

enum CourseStatus {
  ACTIVE
  EXPIRING
  EXPIRED
  ARCHIVED
}

enum CourseListingDecision {
  EXTEND
  ARCHIVE
}

enum CourseListingDecisionStatus {
  PENDING
  APPROVED
  REJECTED
}

/**
 * User-submitted listing lifecycle (pre-publish).
 */
enum CourseRequestStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum CourseCategory {
  TECHNOLOGY
  AI
  DESIGN
  ART
  MARKETING
  BUSINESS_MANAGEMENT
  FINANCE
  LANGUAGES
  SCIENCE
  PSYCHOLOGY
  PERSONAL_DEVELOPMENT
  HEALTH_WELLNESS
  CRAFTS_HOBBIES
  SPORTS
  OTHER
}

enum CourseDelivery {
  LIVE
  VIDEO
}

enum CourseFormat {
  ONLINE
  ONSITE
}

enum TeachingLanguage {
  KA
  EN
}

/**
 * Teacher monthly subscription lifecycle (manual mark-as-paid, mirrors CourseRequestStatus).
 */
enum TeacherSubscriptionStatus {
  PENDING_PAYMENT
  ACTIVE
  EXPIRED
}

model User {
  id          String    @id @default(uuid())
  email       String    @unique
  password    String?
  name        String
  surname     String?
  phone       String?   @unique
  dateOfBirth DateTime?
  role        Role      @default(USER)
  provider    String?
  avatar      String?

  resetToken          String?   @unique
  resetTokenExpires   DateTime?
  verified            Boolean   @default(false)
  verificationToken   String?   @unique
  verificationExpires DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courseRequests    CourseRequest[]
  courses           Course[]
  enrollments       CourseEnrollment[]
  ratings           CourseRating[]
  listingDecisions  CourseListingRequest[] @relation("CourseListingDecisionCreator")
  listingReviews    CourseListingRequest[] @relation("CourseListingDecisionReviewer")
  siteReview        SiteReview?
  chatConversations ChatConversation[]
  chatMessages      ChatMessage[]
  teacherSubscription TeacherSubscription?
  payments          Payment[]
}

model TeacherSubscription {
  id     String                    @id @default(uuid())
  userId String                    @unique
  user   User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status TeacherSubscriptionStatus @default(PENDING_PAYMENT)

  monthlyFee       Int       @default(30)
  currentPeriodEnd DateTime?
  lastPaidAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([currentPeriodEnd])
}

model Course {
  id               Int              @id @default(autoincrement())
  slug             String           @unique
  type             CourseType       @default(COURSE)
  subType          String?
  teachingLanguage TeachingLanguage @default(KA)

  contentLocale String?
  category      CourseCategory @default(OTHER)
  delivery      CourseDelivery @default(LIVE)
  format        CourseFormat   @default(ONLINE)

  creatorId String?
  creator   User?   @relation(fields: [creatorId], references: [id], onDelete: SetNull)

  originalPrice   Int
  discountedPrice Int?
  discountPercent Int?

  imageUrl       String
  imagePositionX String?
  imagePositionY String?

  // ✅ Workshop/LIVE extra location fields
  address          String?
  onlineUrl        String?
  registrationLink String?

  // ✅ Teacher/masterclass contact details
  contactPhone String?
  contactEmail String?

  isGeorgia Boolean @default(true)

  // ✅ i18n texts
  titleKa           String?
  descriptionKa     String?
  syllabusKa        String?
  mentorBioKa       String?
  mentorFirstNameKa String?
  mentorLastNameKa  String?

  titleEn           String?
  descriptionEn     String?
  syllabusEn        String?
  mentorBioEn       String?
  mentorFirstNameEn String?
  mentorLastNameEn  String?

  // Dates
  startDate DateTime?
  endDate   DateTime?
  date      DateTime? // workshop/masterclass date

  listingEndsAt DateTime?
  maxStudents   Int?

  status CourseStatus @default(ACTIVE)

  videos          Video[]
  materials       Material[]
  enrollments     CourseEnrollment[]
  ratings         CourseRating[]
  listingRequests CourseListingRequest[]
  payments        Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, status])
  @@index([discountPercent])
  @@index([listingEndsAt])
  @@index([category])
  @@index([format])
  @@index([delivery])
  @@index([isGeorgia])
}

model CourseListingRequest {
  id            String                      @id @default(uuid())
  courseId      Int
  course        Course                      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  creatorId     String
  creator       User                        @relation("CourseListingDecisionCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  decision      CourseListingDecision
  extensionDays Int?
  status        CourseListingDecisionStatus @default(PENDING)
  reviewedById  String?
  reviewedBy    User?                       @relation("CourseListingDecisionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt    DateTime?
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt

  @@index([courseId])
  @@index([creatorId])
  @@index([status])
  @@index([decision])
}

model CourseRating {
  id        Int      @id @default(autoincrement())
  userId    String
  courseId  Int
  rating    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
  @@index([userId])
}

model SiteReview {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String
  photoUrl  String?
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, createdAt])
  @@index([rating])
}

model CourseEnrollment {
  id        Int      @id @default(autoincrement())
  userId    String
  courseId  Int
  createdAt DateTime @default(now())

  // ✅ Platform commission breakdown (20% on course sales)
  pricePaid       Int @default(0)
  platformFee     Int @default(0)
  creatorEarnings Int @default(0)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
  @@index([userId])
}

model CourseRequest {
  id            String  @id @default(uuid())
  contentLocale String?
  creatorId     String
  creator       User    @relation(fields: [creatorId], references: [id], onDelete: Restrict)

  type             CourseType       @default(COURSE)
  subType          String?
  teachingLanguage TeachingLanguage @default(KA)

  category CourseCategory?
  delivery CourseDelivery?
  format   CourseFormat?

  // ✅ i18n texts (KA required; EN auto-generated on submit)
  titleKa           String?
  descriptionKa     String?
  syllabusKa        String?
  mentorBioKa       String?
  mentorFirstNameKa String?
  mentorLastNameKa  String?

  titleEn           String?
  descriptionEn     String?
  syllabusEn        String?
  mentorBioEn       String?
  mentorFirstNameEn String?
  mentorLastNameEn  String?

  enAutoTranslated Boolean @default(false)

  imageUrl       String?
  imagePositionX String?
  imagePositionY String?

  // ✅ Pricing
  originalPrice   Int?
  discountedPrice Int?
  discountPercent Int?

  // ✅ Listing payment details
  listingDays     Int?
  listingFee      Int?
  listingStartsAt DateTime?
  listingEndsAt   DateTime?
  maxStudents     Int?

  // ✅ Event fields (workshop/masterclass)
  date      DateTime?
  // ✅ Online/Onsite specifics
  address          String?
  onlineUrl        String?
  registrationLink String?

  // ✅ Teacher/masterclass contact details
  contactPhone String?
  contactEmail String?

  // ✅ Live course schedule
  startDate DateTime?
  endDate   DateTime?

  requestVideos    CourseRequestVideo[]
  requestMaterials CourseRequestMaterial[]

  status CourseRequestStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([creatorId])
  @@index([status])
  @@index([discountPercent])
}

model Video {
  id       Int    @id @default(autoincrement())
  url      String
  courseId Int
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

model Material {
  id       Int    @id @default(autoincrement())
  link     String
  courseId Int
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

model CourseRequestVideo {
  id    Int    @id @default(autoincrement())
  url   String
  order Int?

  courseRequestId String
  courseRequest   CourseRequest @relation(fields: [courseRequestId], references: [id], onDelete: Cascade)

  @@index([courseRequestId])
}

model CourseRequestMaterial {
  id   Int    @id @default(autoincrement())
  link String

  courseRequestId String
  courseRequest   CourseRequest @relation(fields: [courseRequestId], references: [id], onDelete: Cascade)

  @@index([courseRequestId])
}

model ChatConversation {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject       String?
  lastMessageAt DateTime  @default(now())
  userReadAt    DateTime?
  adminReadAt   DateTime?
  closedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  messages ChatMessage[]

  @@index([userId])
  @@index([lastMessageAt])
  @@index([closedAt])
}

model ChatMessage {
  id             String           @id @default(uuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User             @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
  @@index([senderId])
}

enum PaymentStatus {
  PENDING
  APPROVED
  DECLINED
  EXPIRED
}

enum PaymentPurpose {
  TEACHER_SUBSCRIPTION
  COURSE_ENROLLMENT
}

model Payment {
  id             String         @id @default(uuid())
  orderId        String         @unique // our order_id sent to Flitt
  flittPaymentId String? // payment_id returned by Flitt
  purpose        PaymentPurpose
  status         PaymentStatus  @default(PENDING)
  amount         Int // minor units (tetri)
  currency       String         @default("GEL")

  userId   String
  courseId Int? // set for COURSE_ENROLLMENT

  rawCallback Json? // last raw callback payload, for audit/debugging
  paidAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([purpose])
}
